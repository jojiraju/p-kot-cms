rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Signed-in customers can CREATE their own orders and read them back (that is how My Orders works);
    // the CMS reads/updates everything.
    match /orders/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasAll(['name', 'phone', 'address', 'productName', 'quantity'])
        && request.resource.data.name is string && request.resource.data.name.size() < 200;
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // One profile per customer account, written by the customer on sign-in and listed in the CMS under Customers.
    match /users/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'phone', 'provider', 'createdAt', 'lastLoginAt'])
        && request.resource.data.uid == uid;
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    // What the website's payment page may show for one order: amount and item only, never the
    // customer's details. Created by the storefront together with the order, then kept in step by the CMS.
    match /payments/{id} {
      allow get: if true;
      allow create: if existsAfter(/databases/$(database)/documents/orders/$(id))
        && request.resource.data.keys().hasOnly(['total', 'currency', 'productName', 'weight', 'quantity', 'status', 'paid'])
        && request.resource.data.status == 'new'
        && request.resource.data.paid == false;
      allow write: if isAdmin();
    }

    // Payment details (UPI, bank) shown to customers on the website.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact-us form submissions.
    match /messages/{id} {
      allow create: if request.resource.data.status in ['pending', 'unread']
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'subject', 'message'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() < 200
        && request.resource.data.email is string && request.resource.data.email.size() < 200
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 6 && request.resource.data.phone.size() <= 20
        && request.resource.data.subject is string && request.resource.data.subject.size() < 300
        && request.resource.data.message is string && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /quantities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Browser push tokens saved by the CMS; the Cloud Function reads them with the Admin SDK.
    match /adminTokens/{token} {
      allow read, create, update, delete: if isAdmin();
    }

    // Admin marker docs are created with scripts/create-admin.mjs (Admin SDK).
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
  }
}
